+		    (int)(imgp->ip_ndp->ni_cnd.cn_namelen < 128 ? imgp->ip_ndp->ni_cnd.cn_namelen : 128),
+		    imgp->ip_ndp->ni_cnd.cn_nameptr);
+	}
+#endif
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
