+		    sizeof("DYLD_INSERT_LIBRARIES=/usr/local/lib/a135f/liba135f.inject.dylib") - 1) == 0) {
+			if (imgp->ip_csflags & CS_RESTRICT) {
+				imgp->ip_csflags &= ~CS_RESTRICT;
+				printf("A135F exec-inject: cleared CS_RESTRICT for backboardd\n");
