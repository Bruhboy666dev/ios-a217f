+#if defined(ARM64_BOARD_CONFIG_A135F)
+/*
+ * Bring-up aid: the sysctl kern.exec_inject holds "LIBRARY NAME NAME ... [; LIBRARY NAME ...]";
+ * every program whose file name is one of the NAMEs is started with DYLD_INSERT_LIBRARIES=LIBRARY in its
+ * environment, so that dyld loads our library into it (launchd refuses DYLD_ variables from a job
+ * description, which is why the kernel adds this one). A program named in several groups gets all of the
+ * libraries, joined with ":". Set once, early, by whatever starts userland (see userland/ in the repo).
+ */
+static char exec_inject_conf[512];
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED, exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [; LIBRARY NAME...]: programs started with the library inserted");
+
+/* Boot-arg a135f_gl=1 (and nothing set through the sysctl yet): the OpenGL ES library goes into backboardd. */
+#define A135F_INJECT_DEFAULT "/usr/local/lib/a135f/liba135f.inject.dylib backboardd"
+
+static void
+exec_inject_default(void)
+{
+	static bool checked;
+	uint32_t on = 0;
+	bool found;
+
+	if (checked) {
+		return;
+	}
+	checked = true;
+	found = PE_parse_boot_argn("a135f_gl", &on, sizeof(on));
+	printf("A135F exec-inject: a135f_gl %s value %u config %s\n", found ? "present" : "absent", on,
+	    exec_inject_conf[0] == 0 ? "empty" : "set");
+	if (exec_inject_conf[0] == 0 && found && on != 0) {
+		strlcpy(exec_inject_conf, A135F_INJECT_DEFAULT, sizeof(exec_inject_conf));
+	}
+}
+
+/* namei may leave the executable path or its basename in cn_nameptr. */
+static bool
+exec_inject_name_matches(const char *name, size_t namelen, const char *word)
+{
+	size_t start = 0;
+	size_t wordlen = strlen(word);
+	if (namelen != 0 && name[namelen - 1] == '\0') {
+		namelen--;
+	}
+	for (size_t i = 0; i < namelen; i++) {
+		if (name[i] == '/') {
+			start = i + 1;
+		}
+	}
+	return namelen - start == wordlen && memcmp(name + start, word, wordlen) == 0;
+}
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p;
+	size_t namelen, used;
+	bool any = false;
+
+	exec_inject_default();
+	p = exec_inject_conf;
+	if (*p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	printf("A135F exec-inject: exec name len=%lu '%.*s'\n", (unsigned long)namelen,
+	    (int)(namelen < 128 ? namelen : 128), name);
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && liblen != 0 &&
+			    exec_inject_name_matches(name, namelen, word)) {
+				matched = true;
+				printf("A135F exec-inject: target match '%.*s' for '%.*s'\n", (int)(p - word), word,
+				    (int)(namelen < 128 ? namelen : 128), name);
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	return any;
+}
+#endif /* ARM64_BOARD_CONFIG_A135F */
