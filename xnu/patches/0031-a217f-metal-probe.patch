From: Codex <codex@localhost>
Subject: [PATCH] A21s: expose a gated Metal probe service

diff --git a/iokit/Kernel/arm/A135FMali.cpp b/iokit/Kernel/arm/A135FMali.cpp
index 7c0e68f..06449b2 100644
--- a/iokit/Kernel/arm/A135FMali.cpp
+++ b/iokit/Kernel/arm/A135FMali.cpp
@@ -12,6 +12,7 @@
  * surface-backed buffers (the GPU is not coherent).
  */
 #include <pexpert/arm64/board_config.h>
+#include <pexpert/pexpert.h>
 
 #if defined(A135F)
 #include <IOKit/IOLib.h>
@@ -116,6 +117,47 @@ A135FMali::start(IOService * provider)
 	return true;
 }
 
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+/* Publish a diagnostic Metal service only for explicit probe boots. */
+static void
+A135FMetalProbeStart(IOService * provider)
+{
+	uint32_t enabled = 0;
+	bool found = PE_parse_boot_argn("a135f_metal_probe", &enabled, sizeof(enabled));
+	IOLog("A135F Metal probe: flag %s value %u\n", found ? "present" : "absent", enabled);
+	if (!found || enabled == 0) return;
+
+	IOAcceleratorES * accelerator = OSTypeAlloc(IOAcceleratorES);
+	if (accelerator == NULL || !accelerator->init()) {
+		OSSafeReleaseNULL(accelerator);
+		IOLog("A135F Metal probe: could not allocate IOAcceleratorES\n");
+		return;
+	}
+	accelerator->setName("mali");
+	accelerator->setProperty(kIOUserClientClassKey, "A135FMaliUserClient");
+	accelerator->setProperty("MetalPluginName", "A135FMetalProbe");
+	accelerator->setProperty("MetalPluginClassName", "A135FMetalProbeDevice");
+	if (!accelerator->attach(provider)) {
+		accelerator->release();
+		IOLog("A135F Metal probe: could not attach IOAcceleratorES\n");
+		return;
+	}
+	if (!accelerator->start(provider)) {
+		accelerator->detach(provider);
+		accelerator->release();
+		IOLog("A135F Metal probe: IOAcceleratorES did not start\n");
+		return;
+	}
+	accelerator->registerService();
+	accelerator->release();
+	IOLog("A135F Metal probe: published test-only IOAcceleratorES\n");
+}
+
 void
 A135FMaliStart(void)
 {
@@ -129,9 +171,12 @@ A135FMaliStart(void)
 		IOLog("A135FMali: cannot create the service\n");
 		return;
 	}
-	if (!gpu->start(provider)) {
+	bool started = gpu->start(provider);
+	if (!started) {
 		gpu->detach(provider);
 		IOLog("A135FMali: the service did not start\n");
+	} else {
+		A135FMetalProbeStart(gpu);
 	}
 	gpu->release();
 	IOLog("A135FMali: the GPU is there for programs to draw with\n");
